# OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=sk-your-key-here
# Optional: point to a compatible provider / proxy
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: extra request headers as JSON (auto-set for azure-api.net gateways)
# OPENAI_EXTRA_HEADERS={"api-key": "your-key-here"}
# Optional model overrides
# CHAT_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-large
#
# --- HKUST GenAI gateway example ---
# OPENAI_API_KEY=your-hkust-key
# OPENAI_BASE_URL=https://hkust.azure-api.net/hkust-genai/v1
# CHAT_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-large
